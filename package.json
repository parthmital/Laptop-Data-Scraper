{
	"name": "laptop-data-scraper",
	"private": true,
	"workspaces": [
		"web"
	],
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "npm run build -w web",
		"start": "npm run start -w web",
		"lint": "npm run lint -w web",
		"typecheck": "npm run typecheck -w web",
		"test": "npm run test -w web",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
	},
	"devDependencies": {
		"prettier": "^3.9.10"
	}
}
